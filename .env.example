# Kapture · Supabase environment reference
#
# This file is a SHAPE REFERENCE ONLY. It is committed and, because this repo is
# public and GitHub Pages serves the branch root verbatim, it is readable by
# anyone. Never put a real value in this file. Copy it to a real .env that lives
# OUTSIDE this repository (see "Where the real file goes" below) and fill it in
# there.
#
# One Supabase project backs every Kapture client: the website, Mac, Windows,
# the Chrome extension and later mobile. The variable names below are the shared
# vocabulary, so the same value means the same thing in every repo.
#
# ---------------------------------------------------------------------------
# The rule that decides everything here
# ---------------------------------------------------------------------------
# Supabase has two classes of key and they are not interchangeable:
#
#   PUBLISHABLE (anon)  identifies the project, is meant to ship inside client
#                       software, and grants nothing on its own. What a holder
#                       can read or write is decided entirely by Row Level
#                       Security policies on the database.
#
#   SECRET (service_role)  bypasses Row Level Security completely. It is a
#                          full-access credential. It belongs only on a machine
#                          you control: a server, an Edge Function, or your own
#                          terminal. It must never appear in the website, the
#                          Mac or Windows app bundle, the Chrome extension, a
#                          mobile binary, or any file in this repository.
#
# The website is a static site with no server and no build step, so anything it
# needs is, by construction, visible to every visitor. That is acceptable for
# the publishable key and only for the publishable key. The security boundary
# for this project is Row Level Security, not secrecy of the anon key.
#
# ---------------------------------------------------------------------------
# Where the real file goes
# ---------------------------------------------------------------------------
# Recommended: ~/.config/kapture/.env
# It sits outside every Kapture repo, so no commit in any of them can leak it,
# and all the sibling projects can read the same file.
#
# The website itself needs NO .env to run in production. It only ever needs the
# two public values, which will be written into a small committed config file
# when the connection is actually wired up. The .env matters for local tooling,
# for the desktop and extension builds, and for anything server side later.


# ===========================================================================
# PUBLIC · safe to ship inside client software
# ===========================================================================

# Project URL. Supabase dashboard > Project Settings > Data API > Project URL
# Looks like: https://abcdefghijklmnopqrst.supabase.co
SUPABASE_URL=

# Publishable key. Supabase dashboard > Project Settings > API Keys
# New-style projects show this as a "publishable" key beginning sb_publishable_
# Older projects show it as the "anon" / "public" key, a JWT beginning eyJ
# Set whichever one your project issues. If both exist, prefer the publishable.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=


# ===========================================================================
# SECRET · never in this repo, never in any client binary
# ===========================================================================
# Nothing below this line may be referenced by website JavaScript, by the
# Chrome extension, or by anything shipped to a user's device.

# Full-access key. Bypasses Row Level Security.
# New style: begins sb_secret_    Legacy: the "service_role" JWT.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection password, for migrations and direct SQL.
SUPABASE_DB_PASSWORD=

# Used to sign and verify project JWTs. Leaking it forges any user session.
SUPABASE_JWT_SECRET=

# Personal access token for the Supabase CLI and Management API.
SUPABASE_ACCESS_TOKEN=

# Short project reference, the subdomain in the Project URL. Not secret on its
# own, but it lives here because the CLI reads it alongside the token.
SUPABASE_PROJECT_REF=
